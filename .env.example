# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to git.

# Secret key used to sign Flask session cookies.
# Generate a fresh random value, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to "production" when deploying (keep "development" locally).
FLASK_ENV=development

# Optional: plain HTTP development server.
# run.py binds to all interfaces by default so phones and ESP32 boards can
# reach this computer on the local network.
# HOST=0.0.0.0
# PORT=5000
# FLASK_DEBUG=1

# Optional: override the address encoded in registration QR codes.
# Leave unset to auto-detect this computer's LAN IPv4 address.
# PUBLIC_BASE_URL=http://192.168.1.10:5000
# PUBLIC_PORT=5000

# A device is shown online only while its last heartbeat is this recent.
# DEVICE_HEARTBEAT_TIMEOUT_SECONDS=60

# Shared secret the ESP32 Network Handler sends in the X-Device-Key header.
# Development fallback in app/config.py is used only when this is unset.
# NEVER commit a real production key to git.
DEVICE_API_KEY=PowerAble_Network_2026_Rey_X82k9P

# Optional: local HTTPS helper (python scripts/serve_https.py).
# HTTPS_HOST=0.0.0.0
# HTTPS_PORT=5443

# Optional pairing limits.
# MAX_OUTLETS_PER_USER=16

# Only set to 1 when the site is served over trusted HTTPS.
# Production defaults to 1; local development defaults to 0.
# SESSION_COOKIE_SECURE=0

# Production / Render settings (normally set in the Render dashboard).
# See docs/render-deployment.md for the full deployment guide.
# DATABASE_URL=postgresql://user:password@host/database
# ALLOW_SQLITE_IN_PRODUCTION=0
# ADMIN_USERNAME=installer
# ADMIN_PASSWORD=choose-a-strong-password
